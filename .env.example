VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=marketing@your-domain.pt
BREVO_SENDER_NAME=Your Brand
TRANSFERGEST_BREVO_API_KEY=your-transfergest-brevo-api-key
TRANSFERGEST_BREVO_SMTP_KEY=your-transfergest-smtp-key
TRANSFERGEST_BREVO_SENDER_EMAIL=transfergest@your-domain.pt
TRANSFERGEST_BREVO_SENDER_NAME=TransferGest
# Required for one-click approve/reject links in absence notification emails
ABSENCE_ACTION_SECRET=a-long-random-secret-string-change-me
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Assistente de ideias (Marketing) — chave da API do Claude (só no servidor; nunca com prefixo VITE_)
ANTHROPIC_API_KEY=sk-ant-your-key
# Só se a chave não estiver ligada a um workspace (Console → Settings → Workspaces → ID wrkspc_...)
# ANTHROPIC_WORKSPACE_ID=wrkspc_your-workspace-id
# Opcional: "off" desliga a pesquisa na web do assistente para todos
# MARKETING_IA_WEB_SEARCH=off
